{
	"name": "vault-assistant",
	"version": "1.11.1",
	"description": "OpenAI-compatible chat agent for Obsidian with local RAG and apply-gated note writes.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint . --max-warnings 0",
		"test": "tsc -p tsconfig.test.json --noEmit -skipLibCheck && vitest run",
		"test:watch": "vitest"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"ai",
		"rag"
	],
	"license": "MIT",
	"dependencies": {
		"minisearch": "^7.2.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.28.2",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "1.13.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^4.1.11"
	}
}
